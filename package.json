{
  "name": "koinos-ai",
  "productName": "Koinos AI",
  "version": "0.54.12",
  "private": true,
  "description": "Koinos AI Core — local-first AI with a self-hosted OpenAI-compatible API",
  "license": "MIT",
  "author": "therexdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/therexdev/kaiapp.git"
  },
  "workspaces": [
    "core"
  ],
  "scripts": {
    "core": "node core/server.js",
    "code": "node cli/koinos-code.js",
    "test": "node --test --test-concurrency=2 \"core/test/*.test.js\"",
    "start": "node scripts/run-test.js",
    "live-senses:prepare": "node scripts/prepare-live-senses.js",
    "postinstall": "node scripts/prepare-live-senses.js",
    "predist": "node scripts/prepare-live-senses.js && node scripts/build-windows-helpers.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "version:set": "node core/scripts/set-version.js",
    "start:live": "electron .",
    "core:test": "node scripts/run-test.js core",
    "promote:test": "node scripts/promote-test.js"
  },
  "bin": {
    "koinos-code": "cli/koinos-code.js"
  },
  "devDependencies": {
    "@ricky0123/vad-web": "0.0.29",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.koinosai.desktop",
    "productName": "Koinos AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui/**",
      "cli/**",
      "!core/test/**",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ricky0123/vad-web/dist/bundle.min.js",
        "to": "live-senses/vad/bundle.min.js"
      },
      {
        "from": "node_modules/@ricky0123/vad-web/dist/vad.worklet.bundle.min.js",
        "to": "live-senses/vad/vad.worklet.bundle.min.js"
      },
      {
        "from": "node_modules/@ricky0123/vad-web/dist/silero_vad_v5.onnx",
        "to": "live-senses/vad/silero_vad_v5.onnx"
      },
      {
        "from": "node_modules/.cache/kai-live-senses/turn/smart-turn-v3.2-cpu.onnx",
        "to": "live-senses/turn/smart-turn-v3.2-cpu.onnx"
      },
      {
        "from": "docs/licenses/KAI-LIVE-SENSES.txt",
        "to": "live-senses/LICENSE.txt"
      }
    ],
    "asarUnpack": [
      "cli/**",
      "ui/agents.js",
      "core/lib/jail.js",
      "build/icon.ico",
      "build/icon.png",
      "node_modules/onnxruntime-node/**",
      "node_modules/kokoro-js/**",
      "node_modules/phonemizer/**",
      "node_modules/onnxruntime-web/**",
      "node_modules/sherpa-onnx*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Koinos AI uses the microphone when you start voice input or enable Hey KAI listening.",
        "NSCameraUsageDescription": "Koinos AI uses the camera only while you explicitly enable Camera in KAI Eyes."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "therexdev",
        "repo": "kaiapp",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.2",
    "cron-parser": "5.10.0",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "imapflow": "^1.7.1",
    "koilib": "^9.3.0",
    "kokoro-js": "1.2.1",
    "mailparser": "^3.9.17",
    "nodemailer": "^9.1.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "quickjs-emscripten": "0.32.0",
    "sherpa-onnx-node": "1.13.7"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "sharp": "0.35.4"
  }
}
